# ---------------------------------------------------------------------------
# Weather Wiz API configuration. Copy to server/.env and adjust.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string. Leave empty in development to start an
# in-memory MongoDB automatically (requires dev dependencies).
MONGODB_URI=
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/weatherwiz?retryWrites=true&w=majority

# JWT secrets: at least 32 random characters each in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Refresh cookie. For a client on another site (e.g. GitHub Pages -> Render)
# use COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Set to 1 when running behind one reverse proxy (Render, Heroku, Nginx).
TRUST_PROXY=0

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# Cache time-to-live in seconds
CACHE_TTL_FORECAST_SECONDS=600
CACHE_TTL_AIR_QUALITY_SECONDS=1800
CACHE_TTL_GEOCODE_SECONDS=86400
# How long an expired entry may still be served if Open-Meteo is down
CACHE_STALE_SECONDS=21600

# Upstream (Open-Meteo)
UPSTREAM_TIMEOUT_MS=6000
UPSTREAM_RETRIES=2
UPSTREAM_RETRY_BASE_DELAY_MS=250
